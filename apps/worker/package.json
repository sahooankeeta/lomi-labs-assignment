{
  "name": "@lomi/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "smoke:claude": "tsx --env-file-if-exists=../../.env scripts/smoke-claude.ts",
    "smoke:gemini": "tsx --env-file-if-exists=../../.env scripts/smoke-gemini.ts",
    "test": "vitest run --exclude \"**/*.int.test.ts\" --passWithNoTests"
  },
  "devDependencies": {
    "@lomi/config": "workspace:*"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@lomi/db": "workspace:*",
    "@lomi/extraction": "workspace:*",
    "@lomi/logger": "workspace:*",
    "@lomi/queue": "workspace:*",
    "@lomi/shared": "workspace:*",
    "bullmq": "^6.7.10",
    "unpdf": "^2.2.2"
  }
}
