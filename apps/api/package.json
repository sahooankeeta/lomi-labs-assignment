{
  "name": "@lomi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude \"**/*.int.test.ts\" --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@lomi/config": "workspace:*",
    "form-data": "^4.0.6"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@lomi/db": "workspace:*",
    "@lomi/files": "workspace:*",
    "@lomi/logger": "workspace:*",
    "@lomi/queue": "workspace:*",
    "@lomi/shared": "workspace:*",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  }
}
