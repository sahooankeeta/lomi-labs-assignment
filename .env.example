# Copy to .env and fill in. docker compose reads this file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Local dev (outside docker). Inside compose these are overridden.
DATABASE_URL=postgres://lomi:lomi@localhost:55432/lomi
REDIS_URL=redis://localhost:6379
UPLOAD_DIR=./uploads
FIXTURES_DIR=./fixtures
API_PORT=3000
# trace | debug | info | warn | error. debug also shows /health polls.
LOG_LEVEL=info
# text (default) | json
LOG_FORMAT=text
