# Copy to .env and fill in. docker compose reads this file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Max concurrent Claude calls (default 4).
# LLM_MAX_INFLIGHT=4
# Offline deterministic extractor for tests/e2e (ignores the API key).
# EXTRACTOR=fake
# FAKE_EXTRACTOR_DELAY_MS=0

# Local dev (outside docker). Inside compose these are overridden.
DATABASE_URL=postgres://lomi:lomi@localhost:5432/lomi
# Integration tests: created and migrated automatically, never the dev database.
TEST_DATABASE_URL=postgres://lomi:lomi@localhost:5432/lomi_test
REDIS_URL=redis://localhost:6379
UPLOAD_DIR=./uploads
FIXTURES_DIR=./fixtures
API_PORT=3000
# trace | debug | info | warn | error. debug also shows /health polls.
LOG_LEVEL=info
# text (default) | json
LOG_FORMAT=text
