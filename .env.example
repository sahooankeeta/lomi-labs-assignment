# Copy to .env and fill in. docker compose reads this file.
# Google Gemini key (free tier; https://aistudio.google.com/apikey). Required; also used by smoke:gemini.
GEMINI_API_KEY=

# Local dev (outside docker). Inside compose these are overridden.
# Use any role that can create databases. For the compose postgres service it is lomi / lomi.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/lomi
# Integration tests: created and migrated automatically, never the dev database.
TEST_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/lomi_test
REDIS_URL=redis://localhost:6379
# Relative paths resolve against the repo root (not each app folder); absolute ones are kept.
UPLOAD_DIR=./uploads
FIXTURES_DIR=./fixtures
API_PORT=3000
# trace | debug | info | warn | error. debug also shows /health polls.
LOG_LEVEL=info
# text (default) | json
LOG_FORMAT=text
