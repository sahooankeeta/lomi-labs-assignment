{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "prisma/**",
        "prisma.config.ts",
        "tsconfig*.json",
        "package.json",
        "vite.config.ts",
        "index.html"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:seed": {
      "dependsOn": ["db:migrate"],
      "cache": false,
      "env": ["DATABASE_URL", "FIXTURES_DIR", "UPLOAD_DIR"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["TEST_DATABASE_URL"]
    }
  }
}
